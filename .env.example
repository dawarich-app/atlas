# Atlas .env — everything in this file is OPTIONAL. The defaults below are
# baked into compose.yml and the app entrypoint; copy this only if you want
# to override something.
#
# SECRET_KEY_BASE: auto-generated on first boot and persisted to
#   data/app/.secret_key_base (under the bind-mounted volume). Set this
#   yourself only if you want to share a key across hosts.
# DATABASE_PATH: SQLite path inside the app container; defaults to
#   /data/atlas.sqlite3 (data/app/atlas.sqlite3 on the host).
# DATABASE_URL: leave unset for SQLite. To use Postgres, set a
#   postgres:// URL AND use an image built with ATLAS_DB_ADAPTER=postgres.
#
# SECRET_KEY_BASE=replace-with-output-of-openssl-rand-hex-64
# DATABASE_PATH=/data/atlas.sqlite3
# DATABASE_URL=postgres://user:pass@host:5432/atlas

# DOCKER_GID: REQUIRED for the in-app control plane (Settings → apply:
#   region downloads + sidecar start/stop/update). The app runs as `nobody`
#   and talks to the host docker socket via this supplementary group, so it
#   MUST match the group of the socket as seen INSIDE the container:
#       Linux:  stat -c %g /var/run/docker.sock   # typically 998 or 999
#       macOS (OrbStack / Docker Desktop): the socket maps as gid 0 — use
#       DOCKER_GID=0
#   Without the correct value the maps API still works against already-running
#   sidecars, but Settings cannot manage them (the preflight banner in the app
#   will tell you when this is the case).
# DOCKER_GID=999

# PUID/PGID: uid:gid the app drops to, and the owner it gives ./data/app plus
#   the region dirs ./data/{osm,gtfs,otp,tiles}. Sibling services under ./data
#   keep their own ownership (whosonfirst runs as ${UID:-1001}).
#   Defaults to 65534:65534 (nobody). Set these when the host data dir belongs
#   to someone else — Unraid's nobody:users is 99:100, Synology/QNAP differ —
#   otherwise the app cannot write its DB or generated secret key. The
#   container names the offending directories and exits rather than looping.
# PUID=99
# PGID=100

# Public URL — the scheme/host/port CLIENTS use to reach Atlas.
#
# Out of the box `docker compose up` publishes Caddy on plain HTTP at :8484 and
# PHX_HOST stays `localhost`, which works with no settings here at all (the
# HTTPS redirect always skips localhost/127.0.0.1).
#
# You only need this block once you reach Atlas by a real hostname or IP:
#
#   LAN / headless box over plain HTTP — the shipped topology, no TLS anywhere.
#   PHX_SCHEME=http also turns the HTTPS redirect off, and LiveView's origin
#   check then validates against the real http://HOST:PORT the browser used:
#       PHX_HOST=192.168.5.99
#       PHX_SCHEME=http
#       PHX_PORT=8484
#
#   Behind a TLS-terminating proxy (Traefik, nginx, Dokploy) — the defaults
#   already describe this, so only PHX_HOST is required:
#       PHX_HOST=atlas.example.com
#
# ⚠️ PHX_PORT is the port clients connect to, NOT the port Atlas publishes.
#    It must MATCH the published port — change `ports:` in compose.yml (or your
#    proxy) to move that; PHX_PORT only tells Atlas how to describe itself in
#    redirects, generated URLs and LiveView origin checks.
#
# PHX_SCHEME: `http` or `https` (default: https). A misspelling is rejected at
#   boot rather than silently falling back to https.
# FORCE_SSL: override the HTTPS redirect explicitly (default: true, or false
#   when PHX_SCHEME=http).
# PHX_CHECK_ORIGIN: `false`, or a comma-separated allow list of FULL origins
#   (scheme included), when the values above don't describe every origin
#   clients arrive from.
# PHX_HOST=192.168.5.99
# PHX_SCHEME=http
# PHX_PORT=8484
# FORCE_SSL=false
# PHX_CHECK_ORIGIN=http://192.168.5.99:8484,https://atlas.example.com

# ATLAS_ENV_FILE: where the in-app control plane reads THIS file from, as seen
#   from inside the app container. Defaults to /work/.env, which compose.yml
#   binds from the project root (`.:/work:ro`) — only change it if you mount the
#   project somewhere else.
# ATLAS_ENV_FILE=/work/.env

# Region selection (ISO-2 country code; see Geofabrik for valid extracts)
COUNTRY_CODE=de
PBF_URL=https://download.geofabrik.de/europe/germany-latest.osm.pbf
PBF_NAME=germany-latest.osm.pbf
OVERPASS_DIFF_URL=https://download.geofabrik.de/europe/germany-updates/

# NOTE: pelias/whosonfirst:latest currently IGNORES this — it always pulls the global
# WOF bundle (~68 GB transient, ~3-6 GB final store). Kept here for forward-compat in case
# the upstream image restores country filtering.
WHOSONFIRST_COUNTRY_CODE=de

# Placeholder automatically downloads its official prebuilt database on first
# start (~1.9 GB compressed). Later starts reuse ./data/placeholder/store.sqlite3
# with no network access. Override for an internal mirror if needed.
# PLACEHOLDER_DATABASE_URL=https://data.geocode.earth/placeholder/store.sqlite3.gz
# PLACEHOLDER_CPUS=2

# Set to False to skip SRTM download in Valhalla (saves ~3–30 GB per region).
BUILD_ELEVATION=True

# Map matching (POST /api/v1/map-match). All are optional.
#
# MAP_MATCH_MAX_POINTS: largest trace accepted in one request (default 10000).
#   Matching is superlinear in point count and occupies a Valhalla worker for
#   the whole request, so lower this on a shared instance.
# MAP_MATCH_CONCURRENCY: requests admitted at once (default 4). Excess requests
#   fail fast with HTTP 429 instead of waiting inside the HTTP/Valhalla pools.
# VALHALLA_MATCH_TIMEOUT: milliseconds to wait for a match (default 60000).
#   Deliberately separate from the routing timeout — a full-day trace takes
#   far longer than an A-to-B route.
# MAP_MATCH_MAX_POINTS=10000
# MAP_MATCH_CONCURRENCY=4
# VALHALLA_MATCH_TIMEOUT=60000

# Transit API default; Settings persists the selected engine.
TRANSIT_BACKEND=motis
MOTIS_URL=http://localhost:8081
MOTIS_THREADS=4
MOTIS_MEMORY=4g
